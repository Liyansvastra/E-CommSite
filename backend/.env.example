ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://e-comm-site-xi.vercel.app,https://liyansvastra.github.io

# Supabase admin content storage.
# Keep the service role key only in backend hosting env vars. Never add it to frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAIL=liyansvastra@brillaris.pro
ADMIN_PASSWORD_HASH=pbkdf2_sha256$210000$replace-with-random-salt$replace-with-password-hash
ADMIN_TOKEN_SECRET=replace-with-long-random-token-secret
ADMIN_TOKEN_MAX_AGE_SECONDS=28800

# Legacy fallback only. Prefer ADMIN_PASSWORD_HASH in production.
# ADMIN_PASSWORD=change-this-password-in-production
